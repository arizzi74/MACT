[Unit]
Description=MACT Claude Code Worker
Documentation=https://github.com/arizzi74/MACT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude-worker --config %h/.config/claude-worker/config.json run
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateUsers=yes
ProtectSystem=no
UMask=0077

[Install]
WantedBy=default.target
